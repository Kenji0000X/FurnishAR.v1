# Local environment. Keys belong in the deployment's settings, not in the repo.
.env
.env.local
.env.*.local

node_modules/
npm-debug.log*

# Local Postgres used by npm run test:db
pgdata/

# Generated at build time from the environment (may contain project keys).
dist/config.js

# Next.js build output and its cache.
.next/
next-env.d.ts
.vercel
.env*

# Thumbnails are rendered from each product's own .glb by
# scripts/render-thumbnails.mjs. They are committed, not ignored — the build
# needs them and they are the product's real picture. This entry exists only
# to keep the renderer's scratch PNGs out.
public/thumbs/*.png
