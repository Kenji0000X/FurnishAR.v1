# Local environment. Keys belong in the deployment's settings, not in the repo.
.env
.env.local
.env.*.local

node_modules/
npm-debug.log*

# Local Postgres used by npm run test:db
pgdata/

# Generated at build time from the environment (may contain project keys).
dist/config.js

# Next.js build output and its cache.
.next/
next-env.d.ts
.vercel
.env*

# The audit script writes this; it is a snapshot of one run, not source.
audit-report.json

# ONNX Runtime Web files, copied from node_modules at build time (scripts/copy-ort-assets.mjs).
public/ort/
