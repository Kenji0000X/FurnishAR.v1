<mxCell id="flow-3d-legend" value="&lt;b&gt;Authentication&lt;/b&gt; (P1) answers &lt;i&gt;who&lt;/i&gt; is asking.&lt;br&gt;&lt;b&gt;Authorization&lt;/b&gt; (P5) answers whether that caller may open &lt;i&gt;this&lt;/i&gt; file.&lt;br&gt;A missing object and a denied one both answer 403, so a draft is never revealed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="520" height="70" as="geometry"/></mxCell>
